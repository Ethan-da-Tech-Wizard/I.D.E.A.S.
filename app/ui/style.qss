/* Professional Sleek Theme (VS Code / Ableton Inspired) */
QWidget {
    background-color: #1e1e1e; /* Standard professional dark background */
    color: #cccccc;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #1e1e1e;
}

/* Scrollbars - Clean and minimal */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #424242;
    min-height: 20px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background: #4f4f4f;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 10px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: #424242;
    min-width: 20px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal:hover {
    background: #4f4f4f;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0px; }

/* Splitters */
QSplitter::handle {
    background-color: #2d2d2d;
    width: 2px;
}
QSplitter::handle:hover {
    background-color: #007acc;
}

/* Standard Buttons - Sharp and professional */
QPushButton {
    background-color: #333333;
    border: 1px solid #3e3e42;
    color: #ffffff;
    padding: 6px 14px;
    border-radius: 3px;
}
QPushButton:hover {
    background-color: #3f3f46;
    border: 1px solid #555555;
}
QPushButton:pressed {
    background-color: #007acc;
    border: 1px solid #007acc;
}

/* Specialized Buttons */
QPushButton#runBtn {
    background-color: #0e639c;
    border: 1px solid #1177bb;
    color: white;
}
QPushButton#runBtn:hover {
    background-color: #1177bb;
}

QPushButton#activityBtn {
    background-color: transparent;
    border: none;
    color: #858585;
    font-size: 14px;
    padding: 15px 0px;
    font-weight: bold;
}
QPushButton#activityBtn:hover {
    color: #ffffff;
}
QPushButton#activityBtn[active="true"] {
    color: #ffffff;
    border-left: 2px solid #007acc;
    background-color: #1e1e1e;
}

/* Text Editors */
QPlainTextEdit, QTextEdit {
    background-color: #1e1e1e;
    color: #d4d4d4;
    border: none;
    font-family: 'Fira Code', 'Consolas', 'Courier New', monospace;
    font-size: 14px;
    padding: 5px;
}

/* Line Numbers Widget */
QWidget#LineNumberArea {
    background-color: #1e1e1e;
    color: #858585;
    font-family: 'Fira Code', 'Consolas', 'Courier New', monospace;
    font-size: 14px;
    border-right: 1px solid #2d2d2d;
}

/* Tree and List Views */
QTreeView, QListWidget {
    background-color: #252526;
    border: none;
    color: #cccccc;
    outline: none;
}
QTreeView::item, QListWidget::item {
    padding: 4px;
}
QTreeView::item:hover, QListWidget::item:hover {
    background-color: #2a2d2e;
    color: #ffffff;
}
QTreeView::item:selected, QListWidget::item:selected {
    background-color: #37373d;
    color: #ffffff;
}

/* Tab Widget */
QTabWidget::pane {
    border: none;
    background-color: #1e1e1e;
}
QTabBar::tab {
    background: #2d2d2d;
    color: #969696;
    padding: 8px 16px;
    border-right: 1px solid #1e1e1e;
    border-bottom: 1px solid #2d2d2d;
}
QTabBar::tab:selected {
    background: #1e1e1e;
    color: #ffffff;
    border-top: 1px solid #007acc;
    border-bottom: 1px solid #1e1e1e;
}
QTabBar::tab:hover:!selected {
    background: #2d2d2d;
    color: #cccccc;
}

/* Labels */
QLabel {
    color: #cccccc;
}
QLabel#headerTitle {
    color: #ffffff;
    font-size: 18px;
    font-weight: 600;
}
QLabel#panelTitle {
    color: #bbbbbb;
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;
}

/* Activity Bar */
QWidget#ActivityBar {
    background-color: #333333;
    border-right: none;
}

/* DAW Specific */
QWidget#DawTrack {
    background-color: #252526;
    border: 1px solid #3e3e42;
    border-radius: 4px;
}
QComboBox {
    background-color: #3c3c3c;
    border: 1px solid #3e3e42;
    color: #cccccc;
    padding: 4px;
    border-radius: 2px;
}
QComboBox:drop-down {
    border: none;
}
QPushButton#stepBtn {
    background-color: #2d2d2d;
    border: 1px solid #1e1e1e;
    border-radius: 2px;
}
QPushButton#stepBtn[active="true"] {
    background-color: #007acc; /* Active step (drawn note) */
    border: 1px solid #005a9e;
}
QPushButton#stepBtn[playing="true"] {
    background-color: #ffffff; /* Highlight when playhead hits */
}
QPushButton#fxToggle {
    background-color: #2d2d2d;
    border: 1px solid #3e3e42;
    border-radius: 2px;
    padding: 3px;
    color: #cccccc;
}
QPushButton#fxToggle:checked {
    background-color: #007acc;
    color: #ffffff;
}
QWidget#DawTrack QLineEdit {
    background-color: #3c3c3c;
    border: 1px solid #3e3e42;
    color: #cccccc;
    padding: 4px;
    border-radius: 2px;
}
QPushButton#pitchPreset {
    background-color: #2d2d2d;
    border: 1px solid #3e3e42;
    border-radius: 2px;
    padding: 3px 6px;
    color: #cccccc;
}
QPushButton#pitchPreset:hover {
    background-color: #3c3c3c;
}
