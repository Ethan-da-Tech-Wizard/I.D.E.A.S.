/* ═══════════════════════════════════════════════════════════════════
   I.D.E.A.S. — Premium Dark Theme
   Inspired by Ableton Live, FL Studio, and modern creative tools
   ═══════════════════════════════════════════════════════════════════ */

/* ── Base Reset ───────────────────────────────────────────────────── */
* {
    margin: 0;
    padding: 0;
}

QWidget {
    background-color: #0f0f13;
    color: #d0d0d8;
    font-family: "Inter", "Segoe UI", "SF Pro Display", "Roboto", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #0f0f13;
}

QMainWindow::separator {
    background: #1a1a22;
    width: 2px;
    height: 2px;
}
QMainWindow::separator:hover {
    background: #6c5ce7;
}

/* ── Scrollbars — Ultra-thin, glowing on hover ────────────────────── */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
    margin: 4px 0;
}
QScrollBar::handle:vertical {
    background: rgba(108, 92, 231, 0.3);
    min-height: 30px;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(108, 92, 231, 0.7);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 6px;
    margin: 0 4px;
}
QScrollBar::handle:horizontal {
    background: rgba(108, 92, 231, 0.3);
    min-width: 30px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal:hover {
    background: rgba(108, 92, 231, 0.7);
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0px; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

/* ── Splitters ─────────────────────────────────────────────────── */
QSplitter::handle {
    background-color: #1a1a22;
    width: 2px;
}
QSplitter::handle:hover {
    background-color: #6c5ce7;
}

/* ── Activity Bar — Sleek sidebar icons ───────────────────────── */
QWidget#ActivityBar {
    background-color: #12121a;
    border-right: 1px solid #1e1e2e;
}

QPushButton#activityBtn {
    background-color: transparent;
    border: none;
    border-left: 3px solid transparent;
    color: #4a4a5a;
    font-size: 16px;
    padding: 14px 0px;
    font-weight: 600;
    min-height: 20px;
}
QPushButton#activityBtn:hover {
    color: #a0a0c0;
    background-color: rgba(108, 92, 231, 0.08);
}
QPushButton#activityBtn[active="true"] {
    color: #ffffff;
    border-left: 3px solid #6c5ce7;
    background-color: rgba(108, 92, 231, 0.12);
}

/* ── Standard Buttons ──────────────────────────────────────────── */
QPushButton {
    background-color: #1e1e2e;
    border: 1px solid #2a2a3a;
    color: #d0d0d8;
    padding: 7px 16px;
    border-radius: 6px;
    font-weight: 500;
    font-size: 12px;
}
QPushButton:hover {
    background-color: #2a2a3e;
    border: 1px solid #6c5ce7;
    color: #ffffff;
}
QPushButton:pressed {
    background-color: #6c5ce7;
    border: 1px solid #6c5ce7;
    color: #ffffff;
}

QPushButton#runBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6c5ce7, stop:1 #a855f7);
    border: none;
    color: white;
    font-weight: 600;
    padding: 8px 20px;
    border-radius: 6px;
}
QPushButton#runBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7c6cf7, stop:1 #b865ff);
}

QPushButton#exportBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00b894, stop:1 #00cec9);
    border: none;
    color: white;
    font-weight: 600;
    border-radius: 6px;
}
QPushButton#exportBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00d4a8, stop:1 #00e0db);
}

/* ── Text Editors & Code ──────────────────────────────────────── */
QPlainTextEdit, QTextEdit {
    background-color: #12121a;
    color: #d4d4dc;
    border: 1px solid #1e1e2e;
    border-radius: 4px;
    font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', 'Consolas', monospace;
    font-size: 13px;
    padding: 8px;
    selection-background-color: rgba(108, 92, 231, 0.35);
}

QWidget#LineNumberArea {
    background-color: #12121a;
    color: #4a4a5a;
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
    font-size: 13px;
    border-right: 1px solid #1e1e2e;
}

QTextEdit#OutputConsole {
    background-color: #0a0a10;
    border: 1px solid #1a1a28;
    border-radius: 6px;
    color: #a0e0b0;
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
    font-size: 12px;
    padding: 10px;
}

/* ── Tree and List Views ───────────────────────────────────────── */
QTreeView, QListWidget, QTreeWidget, QListView {
    background-color: #12121a;
    border: 1px solid #1e1e2e;
    border-radius: 4px;
    color: #c0c0cc;
    outline: none;
    padding: 4px;
}
QTreeView::item, QListWidget::item, QTreeWidget::item, QListView::item {
    padding: 5px 8px;
    border-radius: 3px;
}
QTreeView::item:hover, QListWidget::item:hover, QTreeWidget::item:hover, QListView::item:hover {
    background-color: rgba(108, 92, 231, 0.12);
    color: #ffffff;
}
QTreeView::item:selected, QListWidget::item:selected, QTreeWidget::item:selected, QListView::item:selected {
    background-color: rgba(108, 92, 231, 0.25);
    color: #ffffff;
}

/* ── Tab Widget ────────────────────────────────────────────────── */
QTabWidget::pane {
    border: none;
    background-color: #0f0f13;
}
QTabBar::tab {
    background: #16161e;
    color: #6a6a7a;
    padding: 9px 20px;
    border: none;
    border-bottom: 2px solid transparent;
    font-weight: 500;
}
QTabBar::tab:selected {
    background: #0f0f13;
    color: #ffffff;
    border-bottom: 2px solid #6c5ce7;
}
QTabBar::tab:hover:!selected {
    background: #1a1a24;
    color: #b0b0c0;
}
QTabBar::close-button {
    image: none;
    subcontrol-position: right;
}

/* ── Labels ────────────────────────────────────────────────────── */
QLabel {
    color: #b0b0c0;
    background: transparent;
}
QLabel#headerTitle {
    color: #ffffff;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 1px;
}
QLabel#panelTitle {
    color: #6a6a7a;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    padding: 6px 0;
    background: transparent;
}

/* ── ComboBox ──────────────────────────────────────────────────── */
QComboBox {
    background-color: #1a1a24;
    border: 1px solid #2a2a3a;
    color: #d0d0d8;
    padding: 5px 10px;
    border-radius: 5px;
    font-size: 12px;
    min-height: 22px;
}
QComboBox:hover {
    border: 1px solid #6c5ce7;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox QAbstractItemView {
    background-color: #1a1a24;
    border: 1px solid #2a2a3a;
    color: #d0d0d8;
    selection-background-color: rgba(108, 92, 231, 0.3);
    selection-color: #ffffff;
    outline: none;
}

/* ── Slider ────────────────────────────────────────────────────── */
QSlider::groove:horizontal {
    background: #1e1e2e;
    height: 4px;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #6c5ce7;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    background: #7c6cf7;
}
QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6c5ce7, stop:1 #a855f7);
    border-radius: 2px;
}

/* ── SpinBox ───────────────────────────────────────────────────── */
QSpinBox, QDoubleSpinBox {
    background-color: #1a1a24;
    border: 1px solid #2a2a3a;
    color: #d0d0d8;
    padding: 4px 8px;
    border-radius: 4px;
}
QSpinBox:hover, QDoubleSpinBox:hover {
    border: 1px solid #6c5ce7;
}

/* ── LineEdit ──────────────────────────────────────────────────── */
QLineEdit {
    background-color: #1a1a24;
    border: 1px solid #2a2a3a;
    color: #d0d0d8;
    padding: 6px 10px;
    border-radius: 5px;
    selection-background-color: rgba(108, 92, 231, 0.35);
}
QLineEdit:hover, QLineEdit:focus {
    border: 1px solid #6c5ce7;
}

/* ── Menu Bar ──────────────────────────────────────────────────── */
QMenuBar {
    background-color: #12121a;
    color: #b0b0c0;
    border-bottom: 1px solid #1e1e2e;
    padding: 2px 0;
}
QMenuBar::item {
    padding: 6px 12px;
    background: transparent;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background: rgba(108, 92, 231, 0.2);
    color: #ffffff;
}
QMenu {
    background-color: #16161e;
    border: 1px solid #2a2a3a;
    padding: 4px;
    border-radius: 6px;
}
QMenu::item {
    padding: 7px 30px 7px 12px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: rgba(108, 92, 231, 0.25);
    color: #ffffff;
}
QMenu::separator {
    height: 1px;
    background: #2a2a3a;
    margin: 4px 8px;
}

/* ═══════════════════════════════════════════════════════════════
   DAW MODE — Step Sequencer
   ═══════════════════════════════════════════════════════════════ */

QWidget#DawTrack {
    background-color: #16161e;
    border: 1px solid #22222e;
    border-radius: 8px;
    padding: 4px;
}

QWidget#DawTrack QLineEdit {
    background-color: #1a1a24;
    border: 1px solid #2a2a3a;
    color: #d0d0d8;
    padding: 5px 10px;
    border-radius: 5px;
}

/* Step buttons — grid pads */
QPushButton#stepBtn {
    background-color: #1a1a24;
    border: 1px solid #22222e;
    border-radius: 4px;
    min-width: 28px;
    min-height: 36px;
}
QPushButton#stepBtn:hover {
    background-color: #252536;
    border: 1px solid #3a3a4e;
}
QPushButton#stepBtn[active="true"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #6c5ce7, stop:1 #5a4cd0);
    border: 1px solid #7c6cf7;
}
QPushButton#stepBtn[playing="true"] {
    background-color: #ffffff;
    border: 1px solid #ffffff;
}
QPushButton#stepBtn[active="true"][playing="true"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #a855f7, stop:1 #6c5ce7);
    border: 1px solid #c084fc;
}

/* FX toggle buttons */
QPushButton#fxToggle {
    background-color: #1a1a24;
    border: 1px solid #2a2a3a;
    border-radius: 4px;
    padding: 4px 8px;
    color: #6a6a7a;
    font-size: 11px;
    font-weight: 600;
}
QPushButton#fxToggle:hover {
    border: 1px solid #4a4a5e;
    color: #b0b0c0;
}
QPushButton#fxToggle:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6c5ce7, stop:1 #a855f7);
    border: 1px solid #7c6cf7;
    color: #ffffff;
}

/* Tuning buttons */
QPushButton#tuningToggle {
    background-color: #1a1a24;
    border: 1px solid #2a2a3a;
    border-radius: 4px;
    padding: 4px 8px;
    color: #6a6a7a;
    font-weight: 600;
}
QPushButton#tuningToggle:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00b894, stop:1 #00cec9);
    border: 1px solid #00d4a8;
    color: #ffffff;
}

/* Pitch presets */
QPushButton#pitchPreset {
    background-color: #1a1a24;
    border: 1px solid #2a2a3a;
    border-radius: 4px;
    padding: 4px 8px;
    color: #6a6a7a;
    font-size: 11px;
}
QPushButton#pitchPreset:hover {
    background-color: #252536;
    color: #b0b0c0;
}

/* ═══════════════════════════════════════════════════════════════
   ENGINE / DOCK PANELS
   ═══════════════════════════════════════════════════════════════ */

QDockWidget {
    background-color: #12121a;
    border: 1px solid #1e1e2e;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
    font-size: 11px;
    color: #8a8a9a;
}
QDockWidget::title {
    background-color: #16161e;
    padding: 6px 10px;
    border-bottom: 1px solid #1e1e2e;
    text-align: left;
}

QWidget#DockPanelTitleBar {
    background-color: #16161e;
    border-bottom: 1px solid #1e1e2e;
}

QPushButton#DockPanelCloseButton {
    background: transparent;
    border: none;
    color: #6a6a7a;
    font-size: 12px;
    font-weight: bold;
    border-radius: 3px;
    padding: 0px;
}
QPushButton#DockPanelCloseButton:hover {
    background: rgba(255, 100, 100, 0.2);
    color: #ff6b6b;
}

/* ═══════════════════════════════════════════════════════════════
   SCROLL AREA (transparent)
   ═══════════════════════════════════════════════════════════════ */
QScrollArea {
    background: transparent;
    border: none;
}
QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* ═══════════════════════════════════════════════════════════════
   TOOLTIPS
   ═══════════════════════════════════════════════════════════════ */
QToolTip {
    background-color: #1e1e2e;
    border: 1px solid #3a3a4e;
    color: #d0d0d8;
    padding: 6px 10px;
    border-radius: 4px;
    font-size: 12px;
}

/* ═══════════════════════════════════════════════════════════════
   FRAME (generic container)
   ═══════════════════════════════════════════════════════════════ */
QFrame {
    background: transparent;
    border: none;
}

/* ═══════════════════════════════════════════════════════════════
   EDITOR STATUS BAR & EXTENDED PLAYBOOK STYLING
   ═══════════════════════════════════════════════════════════════ */
QWidget#EditorStatusBar {
    background-color: #12121a;
    border-top: 1px solid #1e1e2e;
    color: #858585;
}

QPlainTextEdit {
    caret-color: #00f0ff; /* Glowing cyan caret/cursor */
    selection-background-color: rgba(0, 240, 255, 0.25); /* Cyan selection highlight */
    selection-color: #ffffff;
}

QTabBar::tab {
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 12px;
}

